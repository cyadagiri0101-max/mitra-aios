# ═══════════════════════════════════════════════════════════════════════════════
#  MITRA v3.2 — Environment Configuration
#
#  ⚠️  CRITICAL: This file is a TEMPLATE. You MUST copy it to .env and fill
#     in EVERY placeholder value before starting the application.
#     The app will EXIT with a clear error if any required value is missing.
#
#  HOW TO USE:
#    cp .env.example .env
#    Fill in every REPLACE_WITH_* value below
#    Generate secure secrets:  openssl rand -hex 32
#
#  NEVER commit .env to git. It contains production secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
#  LOCAL DEVELOPMENT vs DOCKER / PODMAN
#
#  The values below (DB_HOST=postgres, REDIS_HOST=redis, etc.) are correct
#  ONLY when running inside Docker/Podman containers.
#
#  If you run "npm run start:dev" directly on your machine (without Docker),
#  change these to localhost:
#    DB_HOST=localhost
#    REDIS_HOST=localhost
#    MINIO_ENDPOINT=localhost
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MITRA v3.2
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# CORS: Update to your actual domain before production deploy
# Example: ALLOWED_ORIGINS=https://mitra.yourcompany.com
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,https://your-domain.com

# ── Database ──────────────────────────────────────────────────────────────────
# For Docker/Podman: DB_HOST=postgres (service name inside compose network)
# For local dev:     DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=mitra_admin
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_min_32_chars
DB_NAME=mitra_v2
DB_SYNC=false
DB_LOGGING=false
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# ── JWT (generate with: openssl rand -hex 32) ────────────────────────────────
# ⚠️  NEVER use the placeholder values in production. Generate real secrets.
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_RANDOM
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_RANDOM
JWT_REFRESH_EXPIRATION=7d

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY_min_16_chars
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY_min_32_chars
MINIO_USE_SSL=false
MINIO_BUCKET=mitra-documents
MINIO_ENABLED=true

# ── Redis ─────────────────────────────────────────────────────────────────────
# For Docker/Podman: REDIS_HOST=redis (service name inside compose network)
# For local dev:     REDIS_HOST=localhost
REDIS_HOST=redis
REDIS_PORT=6379
# ⚠️  If you set a password, Redis will require authentication.
#     The compose healthcheck will automatically adapt.
#     If left empty, Redis runs WITHOUT a password (only for local dev).
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD_min_16_chars

# ── AI / Ollama (Phase 3 — Phi-3 model, requires 4GB+ RAM) ──────────────────────
AI_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT_MS=45000

# ── Seeding (only needed on first run) ───────────────────────────────────────
# ⚠️  This password is used to create the first admin user.
#     Change it after first login.
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_min_16_chars

# ── Auth throttling (per-IP, per window) ──────────────────────────────────────
AUTH_LOGIN_THROTTLE_LIMIT=10
AUTH_LOGIN_THROTTLE_TTL_MS=900000

# ── Rate limiting (global API) ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
