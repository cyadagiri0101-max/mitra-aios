# ═══════════════════════════════════════════════════════════════════════════════
#  MITRA v2.1 — Environment Configuration
#
#  HOW TO USE:
#    cp .env.example .env
#    Fill in every REPLACE_WITH_* value before starting
#    Generate secure secrets:  openssl rand -hex 32
#
#  ⚠️  NEVER commit .env to git.  It contains production secrets.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=mitra_admin
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_min_32_chars
DB_NAME=mitra_v2
DB_SYNC=false
DB_LOGGING=false
DB_SSL=false
DB_POOL_MAX=20
DB_POOL_MIN=2

# ── JWT (generate with: openssl rand -hex 32) ────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_RANDOM
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_RANDOM
JWT_REFRESH_EXPIRATION=7d

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY_min_16_chars
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY_min_32_chars
MINIO_USE_SSL=false
MINIO_BUCKET=mitra-documents
MINIO_ENABLED=true

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
# Comma-separated list of allowed CORS origins
# NOTE: If using Podman rootless, frontend runs on port 8080 (not 80)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,https://your-domain.com

# ── AI / Ollama (Phase 3 — Phi-3 model, requires 4GB+ RAM) ────────────────
AI_ENABLED=false
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=phi3
OLLAMA_TIMEOUT_MS=45000

# ── Seeding (only needed on first run) ────────────────────────────────────────
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD_min_16_chars
# ── Engineering Knowledge Library (EKL) ─────────────────────────────────
EKL_BASE_URL=https://your-ekl.example.com/api
EKL_API_KEY=REPLACE_WITH_EKL_API_KEY
EKL_TIMEOUT_MS=30000
# ── Auth throttling (per-IP, per window) ─────────────────────────────────────
AUTH_LOGIN_THROTTLE_LIMIT=10
AUTH_LOGIN_THROTTLE_TTL_MS=900000
