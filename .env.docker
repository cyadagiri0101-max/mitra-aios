# AIOS Docker Environment Configuration

# Database
POSTGRES_PASSWORD=aios_secure_password_change_me

# LLM Provider (ollama, openai, anthropic)
AIOS_LLM_PROVIDER=ollama

# Embedding Provider (ollama, openai, voyage)
AIOS_EMBEDDING_PROVIDER=ollama

# Vector Store Provider (inmemory, faiss, chroma, qdrant)
AIOS_VECTORSTORE_PROVIDER=inmemory

# Authentication
AIOS_AUTH_ENABLED=false

# CORS Origins (comma-separated)
AIOS_CORS_ORIGINS=*

# API Keys (if using external providers)
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# VOYAGE_API_KEY=your_key_here
