include README.md
include LICENSE
include pyproject.toml
include MANIFEST.in

recursive-include src/aios *.py
recursive-include src/aios/py.typed

recursive-include docs *.md

recursive-include RELEASE *.md *.txt *.yml *.example

prune tests
prune docs/audit
prune docs/methodology
prune docs/standards
prune docs/templates
prune docs/roadmap
prune .github
prune .ai
prune __pycache__
prune *.pyc
prune .git
